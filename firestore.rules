rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/meetingRooms/$(roomId);
    }

    function participantPath(roomId, participantId) {
      return /databases/$(database)/documents/meetingRooms/$(roomId)/participants/$(participantId);
    }

    function memberPath(roomId, userId) {
      return /databases/$(database)/documents/meetingRooms/$(roomId)/members/$(userId);
    }

    function isRoomMember(roomId) {
      return signedIn()
        && exists(memberPath(roomId, request.auth.uid))
        && get(memberPath(roomId, request.auth.uid)).data.authUid == request.auth.uid;
    }

    function isRoomMemberAfter(roomId) {
      return signedIn()
        && existsAfter(memberPath(roomId, request.auth.uid))
        && getAfter(memberPath(roomId, request.auth.uid)).data.authUid == request.auth.uid;
    }

    function isRoomHost(roomId) {
      return signedIn()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.hostAuthUid == request.auth.uid
        && exists(participantPath(roomId, get(roomPath(roomId)).data.hostParticipantId))
        && get(participantPath(roomId, get(roomPath(roomId)).data.hostParticipantId)).data.authUid == request.auth.uid;
    }

    function isRoomHostAfter(roomId) {
      return signedIn()
        && existsAfter(roomPath(roomId))
        && getAfter(roomPath(roomId)).data.hostAuthUid == request.auth.uid
        && existsAfter(participantPath(roomId, getAfter(roomPath(roomId)).data.hostParticipantId))
        && getAfter(participantPath(roomId, getAfter(roomPath(roomId)).data.hostParticipantId)).data.authUid == request.auth.uid;
    }

    function isParticipant(roomId, participantId) {
      return signedIn()
        && exists(participantPath(roomId, participantId))
        && get(participantPath(roomId, participantId)).data.authUid == request.auth.uid;
    }

    function validRoom(roomId, data) {
      return data.id == roomId
        && data.hostAuthUid is string
        && data.hostParticipantId is string
        && data.participantCount is int
        && data.maxParticipants is int
        && data.participantCount >= 1
        && data.participantCount <= data.maxParticipants
        && data.maxParticipants >= 2
        && data.maxParticipants <= 8;
    }

    function isJoiningRoom(roomId) {
      return !isRoomMember(roomId)
        && isRoomMemberAfter(roomId)
        && request.resource.data.participantCount == resource.data.participantCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount', 'updatedAt']);
    }

    function isLeavingRoom(roomId) {
      return isRoomMember(roomId)
        && !existsAfter(memberPath(roomId, request.auth.uid))
        && resource.data.hostAuthUid != request.auth.uid
        && request.resource.data.participantCount == resource.data.participantCount - 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount', 'updatedAt']);
    }

    function isParticipantWorkflowUpdate(roomId) {
      return isRoomMember(roomId)
        && !(resource.data.status in ['PLACE_CONFIRMED', 'MEETING_CONFIRMED'])
        && request.resource.data.status == 'PLACE_SELECTING'
        && request.resource.data.get('confirmedPlace', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedPlace', 'updatedAt']);
    }

    function validParticipant(roomId, participantId, data) {
      return data.keys().hasOnly(['id', 'roomId', 'nickname', 'isHost', 'authUid', 'isInvited', 'joinedAt'])
        && data.id == participantId
        && data.roomId == roomId
        && data.nickname is string
        && data.nickname.size() > 0
        && data.nickname.size() <= 30
        && data.authUid is string
        && data.isHost is bool
        && data.isInvited is bool
        && data.joinedAt is string;
    }

    function validMember(roomId, userId, data) {
      return data.keys().hasOnly(['authUid', 'participantId', 'role', 'joined', 'updatedAt'])
        && userId == data.authUid
        && data.participantId is string
        && data.role in ['host', 'participant']
        && data.joined is bool
        && data.updatedAt is string
        && existsAfter(participantPath(roomId, data.participantId))
        && getAfter(participantPath(roomId, data.participantId)).data.authUid == userId;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'email',
          'displayName',
          'providerId',
          'createdAt',
          'lastLoginAt',
          'updatedAt'
        ])
        && data.keys().hasAll(['createdAt', 'lastLoginAt', 'updatedAt'])
        && (!data.keys().hasAny(['email']) || data.email == null || (data.email is string && data.email.size() <= 320))
        && (!data.keys().hasAny(['displayName']) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (!data.keys().hasAny(['providerId']) || data.providerId == null || data.providerId in ['google.com', 'apple.com'])
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.lastLoginAt is string
        && data.lastLoginAt.size() > 0
        && data.updatedAt is string
        && data.updatedAt.size() > 0;
    }

    // collectionGroup("participants") is used only to find the caller's own rooms.
    match /{path=**}/participants/{participantId} {
      allow list: if signedIn() && resource.data.authUid == request.auth.uid;
    }

    match /roomCodes/{code} {
      // A room code is a bearer invitation. Enumeration remains prohibited.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['code', 'roomId', 'createdAt'])
        && request.resource.data.code == code
        && request.resource.data.roomId == code
        && isRoomHostAfter(request.resource.data.roomId);
      allow update: if false;
      allow delete: if isRoomHost(resource.data.roomId);
    }

    match /meetingRooms/{roomId} {
      // Direct lookup is needed to preview a room after entering its unguessable code.
      allow get: if signedIn();
      allow list: if isRoomMember(roomId);
      allow create: if signedIn()
        && validRoom(roomId, request.resource.data)
        && request.resource.data.hostAuthUid == request.auth.uid
        && isRoomHostAfter(roomId)
        && isRoomMemberAfter(roomId);
      allow update: if signedIn()
        && validRoom(roomId, request.resource.data)
        && request.resource.data.hostAuthUid == resource.data.hostAuthUid
        && request.resource.data.hostParticipantId == resource.data.hostParticipantId
        && (
          isRoomHost(roomId)
          || isJoiningRoom(roomId)
          || isLeavingRoom(roomId)
          || isParticipantWorkflowUpdate(roomId)
        );
      allow delete: if isRoomHost(roomId);

      match /members/{userId} {
        allow get: if signedIn() && (request.auth.uid == userId || isRoomHost(roomId));
        allow list: if isRoomHost(roomId);
        allow create: if signedIn()
          && validMember(roomId, userId, request.resource.data)
          && (request.auth.uid == userId || isRoomHostAfter(roomId));
        allow update: if signedIn()
          && validMember(roomId, userId, request.resource.data)
          && (
            (
              request.auth.uid == userId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined', 'updatedAt'])
            )
            || isRoomHost(roomId)
          );
        allow delete: if signedIn()
          && (
            (request.auth.uid == userId && !isRoomHost(roomId))
            || isRoomHost(roomId)
          );
      }

      match /participants/{participantId} {
        allow read: if isRoomMember(roomId)
          || (signedIn() && resource.data.authUid == request.auth.uid);
        allow create: if signedIn()
          && validParticipant(roomId, participantId, request.resource.data)
          && (
            (
              request.resource.data.authUid == request.auth.uid
              && request.resource.data.isInvited == false
              && existsAfter(memberPath(roomId, request.auth.uid))
            )
            ||
            (
              request.resource.data.isInvited == true
              && isRoomHostAfter(roomId)
              && existsAfter(memberPath(roomId, request.resource.data.authUid))
            )
          );
        allow update: if signedIn()
          && validParticipant(roomId, participantId, request.resource.data)
          && resource.data.authUid == request.auth.uid
          && resource.data.isInvited == true
          && request.resource.data.isInvited == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isInvited', 'joinedAt']);
        allow delete: if signedIn()
          && (
            (
              resource.data.authUid == request.auth.uid
              && !isRoomHost(roomId)
              && !existsAfter(memberPath(roomId, request.auth.uid))
            )
            || isRoomHost(roomId)
          );
      }

      match /availabilities/{availabilityId} {
        allow read: if isRoomMember(roomId);
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['roomId', 'participantId', 'date', 'status', 'updatedAt'])
          && request.resource.data.roomId == roomId
          && request.resource.data.participantId is string
          && request.resource.data.date is string
          && availabilityId == request.resource.data.participantId + '-' + request.resource.data.date
          && request.resource.data.status in ['AVAILABLE', 'MAYBE', 'UNAVAILABLE']
          && isParticipant(roomId, request.resource.data.participantId);
        allow delete: if isParticipant(roomId, resource.data.participantId) || isRoomHost(roomId);
      }

      // Exact coordinates and addresses are private to the participant who owns them.
      match /startLocations/{participantId} {
        allow read: if isParticipant(roomId, participantId);
        allow create, update: if isParticipant(roomId, participantId)
          && request.resource.data.keys().hasOnly([
            'participantId', 'roomId', 'label', 'address', 'latitude', 'longitude', 'privacyLevel', 'updatedAt'
          ])
          && request.resource.data.roomId == roomId
          && request.resource.data.participantId == participantId
          && request.resource.data.label is string
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.privacyLevel in ['EXACT_PRIVATE', 'AREA_ONLY_VISIBLE'];
        allow delete: if isParticipant(roomId, participantId) || isRoomHost(roomId);
      }

      // Other room members receive only a coarse area label and rounded coordinates.
      match /startLocationSummaries/{participantId} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isParticipant(roomId, participantId)
          && request.resource.data.keys().hasOnly([
            'participantId', 'roomId', 'label', 'approximateLatitude', 'approximateLongitude', 'updatedAt'
          ])
          && request.resource.data.roomId == roomId
          && request.resource.data.participantId == participantId
          && request.resource.data.label is string
          && request.resource.data.approximateLatitude is number
          && request.resource.data.approximateLatitude >= -90
          && request.resource.data.approximateLatitude <= 90
          && request.resource.data.approximateLatitude * 100 == int(request.resource.data.approximateLatitude * 100)
          && request.resource.data.approximateLongitude is number
          && request.resource.data.approximateLongitude >= -180
          && request.resource.data.approximateLongitude <= 180
          && request.resource.data.approximateLongitude * 100 == int(request.resource.data.approximateLongitude * 100);
        allow delete: if isParticipant(roomId, participantId) || isRoomHost(roomId);
      }

      match /destinationStationProposals/{participantId} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isParticipant(roomId, participantId)
          && request.resource.data.keys().hasOnly([
            'roomId', 'participantId', 'stationId', 'stationName', 'latitude', 'longitude', 'lines', 'region', 'updatedAt'
          ])
          && request.resource.data.roomId == roomId
          && request.resource.data.participantId == participantId
          && request.resource.data.stationId is string
          && request.resource.data.stationName is string
          && request.resource.data.lines is list;
        allow delete: if isParticipant(roomId, participantId) || isRoomHost(roomId);
      }

      match /destinationStationVotes/{participantId} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isParticipant(roomId, participantId)
          && request.resource.data.keys().hasOnly(['roomId', 'participantId', 'stationId', 'updatedAt'])
          && request.resource.data.roomId == roomId
          && request.resource.data.participantId == participantId
          && request.resource.data.stationId is string;
        allow delete: if isParticipant(roomId, participantId) || isRoomHost(roomId);
      }

      match /nicknameKeys/{nicknameKey} {
        allow get: if signedIn();
        allow list: if isRoomMember(roomId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['participantId'])
          && request.resource.data.participantId is string
          && existsAfter(participantPath(roomId, request.resource.data.participantId))
          && (
            getAfter(participantPath(roomId, request.resource.data.participantId)).data.authUid == request.auth.uid
            || isRoomHostAfter(roomId)
          );
        allow delete: if signedIn()
          && (
            isParticipant(roomId, resource.data.participantId)
            || isRoomHost(roomId)
          );
        allow update: if false;
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserProfile(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUserProfile(request.resource.data)
        && (
          !resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == resource.data.createdAt
          || (
            resource.data.createdAt.matches('.*Z')
            && request.resource.data.createdAt.matches('.*[+]09:00')
          )
        );
      allow delete: if signedIn() && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /notificationDevices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'lastLoginAt', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform in ['android', 'ios']
          && (
            !request.resource.data.keys().hasAny(['lastLoginAt'])
            || request.resource.data.lastLoginAt is string
          )
          && request.resource.data.updatedAt is string;
      }
    }

    match /meetingFriendConnections/{connectionId} {
      allow read, write: if false;
    }
  }
}
