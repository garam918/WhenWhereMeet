rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomHost(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/meetingRooms/$(roomId))
        && exists(/databases/$(database)/documents/meetingRooms/$(roomId)/participants/$(get(/databases/$(database)/documents/meetingRooms/$(roomId)).data.hostParticipantId))
        && get(/databases/$(database)/documents/meetingRooms/$(roomId)/participants/$(get(/databases/$(database)/documents/meetingRooms/$(roomId)).data.hostParticipantId)).data.authUid == request.auth.uid;
    }

    match /roomCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.roomId == code;
      allow update: if false;
      allow delete: if isRoomHost(resource.data.roomId);
    }

    match /meetingRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.id == roomId
        && request.resource.data.hostAuthUid == request.auth.uid
        && request.resource.data.participantCount == 1
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 8
        && existsAfter(/databases/$(database)/documents/meetingRooms/$(roomId)/participants/$(request.resource.data.hostParticipantId))
        && getAfter(/databases/$(database)/documents/meetingRooms/$(roomId)/participants/$(request.resource.data.hostParticipantId)).data.authUid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.id == roomId
        && (
          request.resource.data.hostAuthUid == resource.data.hostAuthUid ||
          (
            resource.data.get('hostAuthUid', null) == null
            && request.resource.data.hostAuthUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostAuthUid'])
          )
        )
        && request.resource.data.maxParticipants >= resource.data.participantCount
        && request.resource.data.maxParticipants <= 8
        && request.resource.data.participantCount >= 1
        && request.resource.data.participantCount <= request.resource.data.maxParticipants;
      allow delete: if isRoomHost(roomId);

      match /participants/{participantId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.id == participantId
          && request.resource.data.roomId == roomId
          && request.resource.data.authUid == request.auth.uid;
        allow update: if signedIn()
          && resource.data.get('authUid', null) == null
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid'])
          && get(/databases/$(database)/documents/meetingRooms/$(roomId)).data.hostParticipantId == participantId
          && get(/databases/$(database)/documents/meetingRooms/$(roomId)).data.hostAuthUid == request.auth.uid;
        allow delete: if signedIn()
          && (
            resource.data.authUid == request.auth.uid ||
            isRoomHost(roomId)
          );
      }

      match /availabilities/{availabilityId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.roomId == roomId
          && request.resource.data.participantId is string
          && request.resource.data.date is string
          && request.resource.data.status in ['AVAILABLE', 'MAYBE', 'UNAVAILABLE'];
        allow delete: if signedIn();
      }

      match /startLocations/{participantId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.roomId == roomId
          && request.resource.data.participantId == participantId
          && request.resource.data.label is string
          && request.resource.data.privacyLevel in ['EXACT_PRIVATE', 'AREA_ONLY_VISIBLE'];
        allow delete: if signedIn()
          && (
            resource.data.participantId == participantId ||
            isRoomHost(roomId)
          );
      }

      match /nicknameKeys/{nicknameKey} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.participantId is string;
        allow delete: if signedIn();
        allow update: if false;
      }
    }
  }
}
