{
  "name": "whenwheremeet-functions",
  "description": "Firebase Functions for WhenWhereMeet",
  "scripts": {
    "lint": "node --check index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:rules": "node --test --test-concurrency=1 test/firestore.rules.test.js",
    "test:account-deletion": "node --test --test-concurrency=1 test/account-deletion.test.js",
    "test:emulator": "firebase --config ../firebase.json emulators:exec --project whenwheremeet-security-test --only firestore \"npm test\"",
    "backfill:room-security": "node scripts/backfill-room-security.js",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.16.0"
  },
  "private": true
}
